# Copy to .env and fill in. .env is gitignored.

# ============================================================================
# Shared (used by both pipelines)
# ============================================================================

# Anthropic API — hype filter, hook copy, scripts, insight distillation.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Local-dev TLS escape hatch for corporate inspecting proxies. DO NOT set in cloud.
# SSL_NO_VERIFY=1

# Per-pipeline data dirs default to ./data/<pipeline>/. Override if needed:
# DATA_DIR=./data
LOG_LEVEL=INFO

# ============================================================================
# brawl pipeline
# ============================================================================

# YouTube Data API v3 key (search + comments). Free tier.
# https://console.cloud.google.com/apis/credentials → enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# YouTube OAuth client for the BRAWL channel (uploads).
# Create OAuth Desktop client → download client_secret.json
BRAWL_YOUTUBE_CLIENT_SECRET_PATH=./secrets/brawl_youtube_client.json
BRAWL_YOUTUBE_TOKEN_PATH=./secrets/brawl_youtube_token.json
BRAWL_YOUTUBE_CHANNEL_ID=

# ============================================================================
# stocks pipeline
# ============================================================================

# TTS — default is free edge-tts. Switch to elevenlabs for production quality.
TTS_PROVIDER=edge
EDGE_VOICE_EN=en-US-AndrewNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=

# Market data
FINNHUB_API_KEY=
NEWSAPI_KEY=

# Image retrieval
PEXELS_API_KEY=
SERPER_API_KEY=
IMAGE_LICENSE_MODE=editorial

# YouTube OAuth client for the STOCKS channel.
STOCKS_YOUTUBE_CLIENT_SECRET_PATH=./secrets/stocks_youtube_client.json
STOCKS_YOUTUBE_TOKEN_PATH=./secrets/stocks_youtube_token.json
STOCKS_YOUTUBE_STAGING_CHANNEL_ID=
STOCKS_YOUTUBE_PUBLIC_CHANNEL_ID=

# Failure alerts (optional)
SLACK_WEBHOOK_URL=
